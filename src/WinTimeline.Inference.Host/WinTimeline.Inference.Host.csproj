<Project Sdk="Microsoft.NET.Sdk">

  <!-- WT166: the process that owns a native engine (llama.cpp, whisper.cpp), so a native crash or
       leak ends here and not in the editor. It speaks WinTimeline.Inference's line protocol on
       stdin and stdout, as Revelei.Generation.Host does for stable-diffusion.cpp. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>WinTimeline.Inference.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinTimeline.Inference\WinTimeline.Inference.csproj" />
  </ItemGroup>

</Project>
