<!-- WT78: which of a copied clip's attributes a paste puts onto the selected clips. -->
<Window x:Class="WinTimeline.App.PasteAttributesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:WinTimeline.App"
        Title="{x:Static app:UiText.PasteAttributesTitle}"
        AutomationProperties.AutomationId="PasteAttributesWindow"
        ThemeMode="System"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="20" MinWidth="360">
    <TextBlock x:Name="AttributesQuestion" TextWrapping="Wrap" AutomationProperties.AutomationId="AttributesQuestion" />
    <CheckBox x:Name="AttributeEffects" Margin="0,12,0,0" IsChecked="True" Content="{x:Static app:UiText.AttributeEffects}" AutomationProperties.AutomationId="AttributeEffects" />
    <CheckBox x:Name="AttributeMarkers" Margin="0,6,0,0" Content="{x:Static app:UiText.AttributeMarkers}" AutomationProperties.AutomationId="AttributeMarkers" />
    <CheckBox x:Name="AttributeColor" Margin="0,6,0,0" IsChecked="True" Content="{x:Static app:UiText.AttributeColor}" AutomationProperties.AutomationId="AttributeColor" />
    <CheckBox x:Name="AttributeMetadata" Margin="0,6,0,0" Content="{x:Static app:UiText.AttributeMetadata}" AutomationProperties.AutomationId="AttributeMetadata" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="{x:Static app:UiText.AttributePaste}" MinWidth="88" IsDefault="True" Click="OnOk" AutomationProperties.AutomationId="AttributesOk" />
      <Button Content="{x:Static app:UiText.Cancel}" MinWidth="88" Margin="8,0,0,0" IsCancel="True" AutomationProperties.AutomationId="AttributesCancel" />
    </StackPanel>
  </StackPanel>
</Window>
