<!-- The main window (WT1): a menu bar, the dock area every panel lands in, and a status bar.
     ThemeMode="System" follows Windows' light or dark setting while the app runs; the Fluent
     theme it selects gives the window Mica on Windows 11. -->
<Window x:Class="WinTimeline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:WinTimeline.App"
        Title="{x:Static app:UiText.AppName}"
        AutomationProperties.AutomationId="MainWindow"
        ThemeMode="System"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">
  <!-- WT13: Ctrl+O, Ctrl+S and Ctrl+Shift+S, bound in MainWindow.Document.cs. -->
  <Window.InputBindings>
    <KeyBinding Command="SaveAs" Gesture="Ctrl+Shift+S" />
  </Window.InputBindings>
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" AutomationProperties.AutomationId="MainMenu">
      <MenuItem Header="{x:Static app:UiText.FileMenu}" AutomationProperties.AutomationId="FileMenu">
        <MenuItem Header="{x:Static app:UiText.OpenMenu}" Command="Open" AutomationProperties.AutomationId="OpenMenuItem" />
        <MenuItem Header="{x:Static app:UiText.SaveMenu}" Command="Save" AutomationProperties.AutomationId="SaveMenuItem" />
        <MenuItem Header="{x:Static app:UiText.SaveAsMenu}" Command="SaveAs" InputGestureText="{x:Static app:UiText.SaveAsGesture}" AutomationProperties.AutomationId="SaveAsMenuItem" />
        <Separator />
        <MenuItem x:Name="RelinkMenuItem" Header="{x:Static app:UiText.RelinkMenu}" Click="OnRelink" AutomationProperties.AutomationId="RelinkMenuItem" />
        <Separator />
        <MenuItem Header="{x:Static app:UiText.ExitMenu}" InputGestureText="{x:Static app:UiText.ExitGesture}" Click="OnExit" AutomationProperties.AutomationId="ExitMenuItem" />
      </MenuItem>
      <MenuItem Header="{x:Static app:UiText.EditMenu}" AutomationProperties.AutomationId="EditMenu">
        <MenuItem Header="{x:Static app:UiText.UndoMenu}" Command="Undo" AutomationProperties.AutomationId="UndoMenuItem" />
        <MenuItem Header="{x:Static app:UiText.RedoMenu}" Command="Redo" AutomationProperties.AutomationId="RedoMenuItem" />
        <Separator />
        <MenuItem Header="{x:Static app:UiText.DuplicateTimelineMenu}" Click="OnDuplicateTimeline" AutomationProperties.AutomationId="DuplicateTimelineMenuItem" />
        <Separator />
        <MenuItem Header="{x:Static app:UiText.MakeCompoundMenu}" Click="OnMakeCompound" AutomationProperties.AutomationId="MakeCompoundMenuItem" />
        <MenuItem Header="{x:Static app:UiText.BreakApartMenu}" Click="OnBreakApart" AutomationProperties.AutomationId="BreakApartMenuItem" />
        <MenuItem Header="{x:Static app:UiText.AddMarkerMenu}" InputGestureText="{x:Static app:UiText.AddMarkerGesture}" Click="OnAddMarker" AutomationProperties.AutomationId="AddMarkerMenuItem" />
        <Separator />
        <MenuItem Header="{x:Static app:UiText.CopyClipsMenu}" InputGestureText="{x:Static app:UiText.CopyClipsGesture}" Click="OnCopyClips" AutomationProperties.AutomationId="CopyClipsMenuItem" />
        <MenuItem Header="{x:Static app:UiText.PasteClipsMenu}" InputGestureText="{x:Static app:UiText.PasteClipsGesture}" Click="OnPasteClips" AutomationProperties.AutomationId="PasteClipsMenuItem" />
        <Separator />
        <MenuItem Header="{x:Static app:UiText.SelectAllMenu}" InputGestureText="{x:Static app:UiText.SelectAllGesture}" Click="OnSelectAll" AutomationProperties.AutomationId="SelectAllMenuItem" />
        <MenuItem Header="{x:Static app:UiText.DeselectAllMenu}" InputGestureText="{x:Static app:UiText.DeselectAllGesture}" Click="OnDeselectAll" AutomationProperties.AutomationId="DeselectAllMenuItem" />
        <MenuItem Header="{x:Static app:UiText.TrackForwardMenu}" InputGestureText="{x:Static app:UiText.TrackForwardGesture}" Click="OnTrackForward" AutomationProperties.AutomationId="TrackForwardMenuItem" />
        <MenuItem Header="{x:Static app:UiText.TrackBackwardMenu}" InputGestureText="{x:Static app:UiText.TrackBackwardGesture}" Click="OnTrackBackward" AutomationProperties.AutomationId="TrackBackwardMenuItem" />
      </MenuItem>
      <MenuItem Header="{x:Static app:UiText.ViewMenu}" AutomationProperties.AutomationId="ViewMenu">
        <MenuItem Header="{x:Static app:UiText.PaletteMenu}" InputGestureText="{x:Static app:UiText.PaletteGesture}" Click="OnPalette" AutomationProperties.AutomationId="PaletteMenuItem" />
        <Separator />
        <MenuItem Header="{x:Static app:UiText.RulerMenu}" AutomationProperties.AutomationId="RulerMenu">
          <MenuItem x:Name="RulerTimecode" Header="{x:Static app:UiText.RulerTimecodeMenu}" IsCheckable="True" Click="OnRulerUnit" Tag="Timecode" AutomationProperties.AutomationId="RulerTimecodeMenuItem" />
          <MenuItem x:Name="RulerFrames" Header="{x:Static app:UiText.RulerFramesMenu}" IsCheckable="True" Click="OnRulerUnit" Tag="Frames" AutomationProperties.AutomationId="RulerFramesMenuItem" />
          <MenuItem x:Name="RulerFeet" Header="{x:Static app:UiText.RulerFeetMenu}" IsCheckable="True" Click="OnRulerUnit" Tag="FeetFrames" AutomationProperties.AutomationId="RulerFeetMenuItem" />
          <MenuItem x:Name="RulerSeconds" Header="{x:Static app:UiText.RulerSecondsMenu}" IsCheckable="True" Click="OnRulerUnit" Tag="Seconds" AutomationProperties.AutomationId="RulerSecondsMenuItem" />
        </MenuItem>
        <MenuItem x:Name="SnappingMenuItem" Header="{x:Static app:UiText.SnappingMenu}" InputGestureText="{x:Static app:UiText.SnappingGesture}" IsCheckable="True" IsChecked="True" Click="OnSnapping" AutomationProperties.AutomationId="SnappingMenuItem" />
        <MenuItem Header="{x:Static app:UiText.FollowMenu}" AutomationProperties.AutomationId="FollowMenu">
          <MenuItem x:Name="FollowPage" Header="{x:Static app:UiText.FollowPageMenu}" IsCheckable="True" Click="OnFollow" Tag="Page" AutomationProperties.AutomationId="FollowPageMenuItem" />
          <MenuItem x:Name="FollowSmooth" Header="{x:Static app:UiText.FollowSmoothMenu}" IsCheckable="True" Click="OnFollow" Tag="Smooth" AutomationProperties.AutomationId="FollowSmoothMenuItem" />
          <MenuItem x:Name="FollowOff" Header="{x:Static app:UiText.FollowOffMenu}" IsCheckable="True" Click="OnFollow" Tag="Off" AutomationProperties.AutomationId="FollowOffMenuItem" />
        </MenuItem>
        <MenuItem Header="{x:Static app:UiText.ZoomInMenu}" InputGestureText="{x:Static app:UiText.ZoomInGesture}" Click="OnZoomIn" AutomationProperties.AutomationId="ZoomInMenuItem" />
        <MenuItem Header="{x:Static app:UiText.ZoomOutMenu}" InputGestureText="{x:Static app:UiText.ZoomOutGesture}" Click="OnZoomOut" AutomationProperties.AutomationId="ZoomOutMenuItem" />
        <MenuItem Header="{x:Static app:UiText.ZoomFitMenu}" InputGestureText="{x:Static app:UiText.ZoomFitGesture}" Click="OnZoomFit" AutomationProperties.AutomationId="ZoomFitMenuItem" />
        <Separator />
        <MenuItem Header="{x:Static app:UiText.ProblemsMenu}" Click="OnProblems" AutomationProperties.AutomationId="ProblemsMenuItem" />
        <MenuItem Header="{x:Static app:UiText.CompareMenu}" Click="OnCompare" AutomationProperties.AutomationId="CompareMenuItem" />
      </MenuItem>
      <MenuItem Header="{x:Static app:UiText.HelpMenu}" AutomationProperties.AutomationId="HelpMenu">
        <MenuItem Header="{x:Static app:UiText.DiagnosticsMenu}" Click="OnDiagnostics" AutomationProperties.AutomationId="DiagnosticsMenuItem" />
      </MenuItem>
    </Menu>

    <!-- WT7: shown on the start after a crash. -->
    <Border x:Name="RecoveryBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="12,8"
            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
            AutomationProperties.AutomationId="RecoveryBar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="{x:Static app:UiText.SaveDiagnostics}" Margin="8,0,0,0" Click="OnDiagnostics" AutomationProperties.AutomationId="RecoveryDiagnostics" />
          <Button Content="{x:Static app:UiText.Dismiss}" Margin="8,0,0,0" Click="OnRecoveryDismiss" AutomationProperties.AutomationId="RecoveryDismiss" />
        </StackPanel>
        <TextBlock x:Name="RecoveryText" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="RecoveryText" />
      </DockPanel>
    </Border>

    <!-- WT17: edits a session that did not close cleanly left behind. -->
    <Border x:Name="EditsRecoveryBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="12,8"
            Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
            AutomationProperties.AutomationId="EditsRecoveryBar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="{x:Static app:UiText.RecoverEdits}" Margin="8,0,0,0" Click="OnRecoverEdits" AutomationProperties.AutomationId="RecoverEdits" />
          <Button Content="{x:Static app:UiText.Discard}" Margin="8,0,0,0" Click="OnDiscardEdits" AutomationProperties.AutomationId="DiscardEdits" />
        </StackPanel>
        <TextBlock x:Name="EditsRecoveryText" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="EditsRecoveryText" />
      </DockPanel>
    </Border>

    <!-- WT69: notices, non-modal, newest last (MainWindow.Notices.cs). -->
    <StackPanel x:Name="NoticeArea" DockPanel.Dock="Top" AutomationProperties.AutomationId="NoticeArea" />

    <StatusBar DockPanel.Dock="Bottom" AutomationProperties.AutomationId="StatusBar">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" Text="{x:Static app:UiText.Ready}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock x:Name="PlayheadStatus" FontFamily="Consolas" AutomationProperties.AutomationId="PlayheadStatus" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock x:Name="GpuStatus" AutomationProperties.AutomationId="GpuStatus" />
      </StatusBarItem>
    </StatusBar>

    <!-- WT20: one tab per timeline when the file holds several (MainWindow.Timelines.cs). -->
    <TabControl x:Name="TimelineTabs" DockPanel.Dock="Top" Visibility="Collapsed"
                AutomationProperties.AutomationId="TimelineTabs" />

    <!-- The viewer and timeline surfaces (MainWindow.Surfaces.cs); the inspectors dock here later. -->
    <Grid>
      <Grid x:Name="DockArea" AutomationProperties.AutomationId="DockArea" Visibility="Collapsed" />

      <!-- WT68: shown while no document is open; the surfaces' child windows cannot be drawn over (airspace), so it takes their place. -->
      <ScrollViewer x:Name="WelcomePanel" VerticalScrollBarVisibility="Auto" AllowDrop="True" DragOver="OnWelcomeDragOver" Drop="OnWelcomeDrop" AutomationProperties.AutomationId="WelcomePanel">
        <StackPanel MaxWidth="760" Margin="32,28">
          <TextBlock Text="{x:Static app:UiText.AppName}" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="{x:Static app:UiText.WelcomeLine}" Margin="0,4,0,20" Opacity="0.75" />
          <Border x:Name="DropZone"
                  MinHeight="140" Padding="24" CornerRadius="8" BorderThickness="2"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  AutomationProperties.AutomationId="DropZone" AutomationProperties.Name="{x:Static app:UiText.DropZoneName}">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Text="{x:Static app:UiText.DropZoneText}" FontSize="16" />
          </Border>
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="{x:Static app:UiText.OpenButton}" Command="Open" MinWidth="120" AutomationProperties.AutomationId="WelcomeOpen" />
            <Button Content="{x:Static app:UiText.NewEmptyTimeline}" Margin="8,0,0,0" MinWidth="120" Click="OnNewTimeline" AutomationProperties.AutomationId="WelcomeNew" />
          </StackPanel>
          <TextBlock Text="{x:Static app:UiText.Recent}" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,8" />
          <TextBlock x:Name="NoRecent" Text="{x:Static app:UiText.NothingOpened}" Opacity="0.7" AutomationProperties.AutomationId="NoRecent" />
          <ItemsControl x:Name="RecentList" AutomationProperties.AutomationId="RecentList" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
