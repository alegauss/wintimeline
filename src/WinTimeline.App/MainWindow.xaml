<!-- The main window (WT1): a menu bar, the dock area every panel lands in, and a status bar.
     ThemeMode="System" follows Windows' light or dark setting while the app runs; the Fluent
     theme it selects gives the window Mica on Windows 11. -->
<Window x:Class="WinTimeline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTimeline"
        AutomationProperties.AutomationId="MainWindow"
        ThemeMode="System"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">
  <!-- WT13: Ctrl+O, Ctrl+S and Ctrl+Shift+S, bound in MainWindow.Document.cs. -->
  <Window.InputBindings>
    <KeyBinding Command="SaveAs" Gesture="Ctrl+Shift+S" />
  </Window.InputBindings>
  <DockPanel>
    <Menu DockPanel.Dock="Top" AutomationProperties.AutomationId="MainMenu">
      <MenuItem Header="_File" AutomationProperties.AutomationId="FileMenu">
        <MenuItem Header="_Open…" Command="Open" AutomationProperties.AutomationId="OpenMenuItem" />
        <MenuItem Header="_Save" Command="Save" AutomationProperties.AutomationId="SaveMenuItem" />
        <MenuItem Header="Save _As…" Command="SaveAs" InputGestureText="Ctrl+Shift+S" AutomationProperties.AutomationId="SaveAsMenuItem" />
        <Separator />
        <MenuItem x:Name="RelinkMenuItem" Header="_Relink media…" Click="OnRelink" AutomationProperties.AutomationId="RelinkMenuItem" />
        <Separator />
        <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnExit" AutomationProperties.AutomationId="ExitMenuItem" />
      </MenuItem>
      <MenuItem Header="_Edit" AutomationProperties.AutomationId="EditMenu">
        <MenuItem Header="_Undo" Command="Undo" AutomationProperties.AutomationId="UndoMenuItem" />
        <MenuItem Header="_Redo" Command="Redo" AutomationProperties.AutomationId="RedoMenuItem" />
        <Separator />
        <MenuItem Header="_Duplicate timeline as version" Click="OnDuplicateTimeline" AutomationProperties.AutomationId="DuplicateTimelineMenuItem" />
      </MenuItem>
      <MenuItem Header="_View" AutomationProperties.AutomationId="ViewMenu">
        <MenuItem Header="_Problems…" Click="OnProblems" AutomationProperties.AutomationId="ProblemsMenuItem" />
        <MenuItem Header="_Compare with another version…" Click="OnCompare" AutomationProperties.AutomationId="CompareMenuItem" />
      </MenuItem>
      <MenuItem Header="_Help" AutomationProperties.AutomationId="HelpMenu">
        <MenuItem Header="Create _diagnostics bundle…" Click="OnDiagnostics" AutomationProperties.AutomationId="DiagnosticsMenuItem" />
      </MenuItem>
    </Menu>

    <!-- WT7: shown on the start after a crash. -->
    <Border x:Name="RecoveryBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="12,8"
            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
            AutomationProperties.AutomationId="RecoveryBar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Save diagnostics bundle…" Margin="8,0,0,0" Click="OnDiagnostics" AutomationProperties.AutomationId="RecoveryDiagnostics" />
          <Button Content="Dismiss" Margin="8,0,0,0" Click="OnRecoveryDismiss" AutomationProperties.AutomationId="RecoveryDismiss" />
        </StackPanel>
        <TextBlock x:Name="RecoveryText" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="RecoveryText" />
      </DockPanel>
    </Border>

    <!-- WT17: edits a session that did not close cleanly left behind. -->
    <Border x:Name="EditsRecoveryBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="12,8"
            Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
            AutomationProperties.AutomationId="EditsRecoveryBar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Recover edits" Margin="8,0,0,0" Click="OnRecoverEdits" AutomationProperties.AutomationId="RecoverEdits" />
          <Button Content="Discard" Margin="8,0,0,0" Click="OnDiscardEdits" AutomationProperties.AutomationId="DiscardEdits" />
        </StackPanel>
        <TextBlock x:Name="EditsRecoveryText" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="EditsRecoveryText" />
      </DockPanel>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" AutomationProperties.AutomationId="StatusBar">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" Text="Ready" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock x:Name="GpuStatus" AutomationProperties.AutomationId="GpuStatus" />
      </StatusBarItem>
    </StatusBar>

    <!-- WT20: one tab per timeline when the file holds several (MainWindow.Timelines.cs). -->
    <TabControl x:Name="TimelineTabs" DockPanel.Dock="Top" Visibility="Collapsed"
                AutomationProperties.AutomationId="TimelineTabs" />

    <!-- The viewer and timeline surfaces (MainWindow.Surfaces.cs); the inspectors dock here later. -->
    <Grid x:Name="DockArea" AutomationProperties.AutomationId="DockArea" />
  </DockPanel>
</Window>
