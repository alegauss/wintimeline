<!-- WT21: what changed between another timeline of the document and the one shown. -->
<Window x:Class="WinTimeline.App.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare"
        AutomationProperties.AutomationId="CompareWindow"
        ThemeMode="System"
        Width="720" Height="460" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Text="Changes from" />
      <TextBlock x:Name="ToName" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.AutomationId="CompareTo" />
      <ComboBox x:Name="CompareWith" SelectionChanged="OnChosen" AutomationProperties.AutomationId="CompareWith" AutomationProperties.Name="Compare from" />
    </DockPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="Close" MinWidth="96" IsCancel="True" Click="OnClose" AutomationProperties.AutomationId="CompareClose" />
      <TextBlock x:Name="CompareSummary" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="CompareSummary" />
    </DockPanel>
    <ListBox x:Name="ChangeList" AutomationProperties.AutomationId="ChangeList" />
  </DockPanel>
</Window>
