<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local inference through Windows ML and the model library it reads; nothing here calls a cloud API.
       Started empty by WT1; the block that first needs it fills it. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>WinTimeline.Inference</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- WT99: Windows ML without the Windows App SDK, as Revelei proved it (its PB43 spike): its own
         ONNX Runtime with DirectML, plus the TensorRT-RTX, OpenVINO and QNN providers Windows Update
         installs for this PC. Revelei's version. -->
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one device's adapters (WT3): inference follows the app's GPU choice. -->
    <ProjectReference Include="..\WinTimeline.Render\WinTimeline.Render.csproj" />
    <ProjectReference Include="..\WinTimeline.Diagnostics\WinTimeline.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WT100: the catalog ships inside the app; its schema sits beside it for the tests and editors. -->
    <EmbeddedResource Include="Catalog\models.json" LogicalName="WinTimeline.Inference.models.json" />
    <None Include="Catalog\models.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests load ProbeModel to run a real session without a downloaded model. -->
    <InternalsVisibleTo Include="WinTimeline.Inference.Tests" />
  </ItemGroup>

</Project>
