{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alegauss/wintimeline/catalog/models.schema.json",
  "title": "WinTimeline model catalog",
  "description": "WT100: every model WinTimeline can download, pinned to a commit, with its hash, size, licence and needs.",
  "type": "object",
  "required": ["catalog_version", "updated", "models"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "catalog_version": { "type": "integer", "minimum": 1, "description": "Raised on every published change; a newer catalog replaces an older one." },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "models": { "type": "array", "items": { "$ref": "#/$defs/model" } }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": ["schema", "id", "name", "feature", "engine", "licence", "source", "variants"],
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "integer", "minimum": 1, "description": "The entry's schema; an app that does not know it skips the entry." },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "feature": { "enum": ["voice-activity", "transcription", "semantic-search", "assistant", "shot-detection", "segmentation", "interpolation", "audio-cleanup", "stem-separation"] },
        "engine": { "enum": ["onnx", "llama.cpp", "whisper.cpp"] },
        "description": { "type": "string" },
        "licence": {
          "type": "object",
          "required": ["spdx", "commercial_use", "url"],
          "additionalProperties": false,
          "properties": {
            "spdx": { "type": "string", "minLength": 1 },
            "commercial_use": { "type": "boolean" },
            "url": { "type": "string", "pattern": "^https://" }
          }
        },
        "source": {
          "type": "object",
          "required": ["repo", "revision"],
          "additionalProperties": false,
          "properties": {
            "repo": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
            "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "variants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/variant" } }
      }
    },
    "variant": {
      "type": "object",
      "required": ["id", "files", "min_vram_mb", "min_ram_mb", "providers"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "default": { "type": "boolean" },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
        "min_vram_mb": { "type": "integer", "minimum": 0 },
        "min_ram_mb": { "type": "integer", "minimum": 0 },
        "providers": { "type": "array", "minItems": 1, "items": { "enum": ["cpu", "directml", "windowsml", "cuda", "vulkan"] } },
        "speed": {
          "type": "object",
          "required": ["measured_on", "value", "unit"],
          "additionalProperties": false,
          "properties": {
            "measured_on": { "type": "string" },
            "value": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "type": "string" }
          }
        }
      }
    },
    "file": {
      "type": "object",
      "required": ["path", "url", "sha256", "size"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://huggingface\\.co/[\\w.-]+/[\\w.-]+/resolve/[0-9a-f]{40}/" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
