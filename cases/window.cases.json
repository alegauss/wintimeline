{
  // WT1: the first cases, read through the accessibility tree.

  "fixtures": [
    {
      "name": "the window a default start opens",
      "arguments": [],
      "shareable": true
    },
    {
      // WT3: the software rasteriser, which every desk has, so the GPU chip reads the same everywhere.
      "name": "a window forced onto WARP",
      "arguments": ["--adapter", "warp"],
      "shareable": true
    }
  ],

  "cases": [
    {
      "name": "a default start puts a window named WinTimeline on the desk",
      "catches": "an app that builds its window and then shows something else, or nothing at all, which every in-process test would pass",
      "filed": "WT1",
      "tags": ["smoke", "window"],
      "fixture": "the window a default start opens",
      "steps": [
        {
          "locator": "TitleBar",
          "act": "read",
          "reads": "name",
          "matches": "WinTimeline$",
          "named": "the title bar ends in the app's name"
        }
      ]
    },

    {
      "name": "the empty window has a menu bar, a dock area and a status bar",
      "catches": "a window that opens without the chrome every later panel docks into",
      "filed": "WT1",
      "tags": ["smoke", "window"],
      "fixture": "the window a default start opens",
      "steps": [
        {
          "locator": "MenuItem#FileMenu",
          "act": "read",
          "reads": "name",
          "expect": "File",
          "named": "the menu bar starts with File"
        },
        {
          "locator": "Text#StatusText",
          "act": "read",
          "reads": "name",
          "expect": "Ready",
          "named": "the status bar says Ready"
        }
      ]
    },

    {
      "name": "the status bar names the GPU the app runs on",
      "catches": "a device that fails to open, or opens on an adapter the status bar never names",
      "filed": "WT3",
      "tags": ["smoke", "gpu"],
      "fixture": "the window a default start opens",
      "steps": [
        {
          "locator": "Text#GpuStatus",
          "act": "read",
          "reads": "name",
          "matches": "^GPU: .+",
          "named": "the GPU chip names an adapter"
        }
      ]
    },

    {
      "name": "--adapter warp runs on the software rasteriser whatever GPU the desk has",
      "catches": "an --adapter flag that is parsed and then ignored, leaving the device on the hardware GPU",
      "filed": "WT3",
      "tags": ["gpu", "command-line"],
      "fixture": "a window forced onto WARP",
      "steps": [
        {
          "locator": "Text#GpuStatus",
          "act": "read",
          "reads": "name",
          "expect": "GPU: Microsoft Basic Render Driver (software)",
          "named": "the GPU chip names WARP"
        }
      ]
    }
  ]
}
