        },
        {
          "locator": "MenuItem#FileMenu",
          "act": "expand",
          "named": "the File menu is opened"
        },
        {
          "locator": "MenuItem#SaveAsMenuItem",
          "act": "invoke",
          "named": "Save As is chosen"
        },
        {
          "locator": "Window[class=\"#32770\"]",
          "act": "choose file",
          "with": "{files}/copy.otioz",
          "named": "the dialog is told to save copy.otioz"
        },
        {
          "locator": "Text#StatusText",
          "act": "read",
          "reads": "name",
          "expect": "Saved copy.otioz.",
          "named": "the status bar says it saved"
        }
      ]
    },

    {
      "name": "an EDL opens as a timeline of its events",
      "catches": "an EDL the app cannot open, or one read into the wrong number of clips",
      "filed": "WT15",
      "tags": ["open", "edl", "import"],
      "fixture": "a window opened on an EDL",
      "steps": [
        {
          "locator": "Text#StatusText",
          "act": "read",
          "reads": "name",
          "matches": "^Opened dissolve_test\\.edl: 3 clips on 1 track\\.",
          "named": "the EDL's three events are three clips on the V track"
        },
        {
          "locator": "TitleBar",
          "act": "read",
          "reads": "name",
          "matches": "^dissolve_test\\.edl — WinTimeline$",
          "named": "and the title names it"
        }
      ]
    },

    {
      "name": "a freshly opened timeline has nothing to undo or redo",
      "catches": "an Undo that can be pressed before any edit, which would undo the open itself or throw",
      "filed": "WT16",
      "tags": ["edit", "history"],
      "fixture": "a window opened on the simple cut",
      "steps": [
        {
          "locator": "MenuItem#EditMenu",
          "act": "expand",
          "named": "the Edit menu is opened"
        },
        {
          "locator": "MenuItem#UndoMenuItem",
          "act": "read",
          "reads": "enabled",
          "expect": "not enabled",
          "named": "Undo waits for an edit"
        },
        {
          "locator": "MenuItem#RedoMenuItem",
          "act": "read",
          "reads": "enabled",
          "expect": "not enabled",
          "named": "and so does Redo"
        }
      ]
    },

    {
      "name": "an edit made before a crash is offered back and recovered",
      "catches": "a crash that loses every edit since the last save, or a recovery that brings back the file as saved instead of as edited",
      "filed": "WT17",
      "tags": ["crash", "recovery", "autosave"],
      "fixture": "a window started after a crash with an unsaved edit",
      "steps": [
        {
          "locator": "Text#EditsRecoveryText",
          "act": "read",
          "reads": "name",
