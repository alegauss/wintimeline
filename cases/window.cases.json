    {
      "name": "a broken timeline says so on open and its fixable problem is fixed from the Problems panel",
      "catches": "a malformed timeline that opens silently, or a problem whose fix does nothing",
      "filed": "WT19",
      "tags": ["problems", "validation", "dialog"],
      "fixture": "a window on a timeline with a transition too long",
      "steps": [
        {
          "locator": "Text#StatusText",
          "act": "read",
          "reads": "name",
          "expect": "Opened long-transition.otio: 2 clips on 1 track. 1 problem: View > Problems.",
          "named": "the open says there is a problem"
        },
        {
          "locator": "MenuItem#ViewMenu",
          "act": "expand",
          "named": "the View menu is opened"
        },
        {
          "locator": "MenuItem#ProblemsMenuItem",
          "act": "invoke",
          "named": "Problems is chosen"
        },
        {
          "locator": "List#ProblemList > ListItem[order=top]",
          "act": "read",
          "reads": "name",
          "expect": "Error at 0/1: Transition \"x\" reaches further than a and b last. (fixable)",
