{
  // WT1: the first cases, read through the accessibility tree.

  "fixtures": [
    {
      "name": "the window a default start opens",
      "arguments": [],
      "shareable": true
    },
    {
      // WT3: the software rasteriser, which every desk has, so the GPU chip reads the same everywhere.
      "name": "a window forced onto WARP",
      "arguments": ["--adapter", "warp"],
      "shareable": true
    },
    {
      // WT5: a settings file cut off mid-write, staged as the data folder's settings.json.
      "name": "a window started on a damaged settings file",
      "files": ["cases/fixtures/settings/settings.json"],
      "variables": { "WINTIMELINE_DATA": "{files}" },
      "arguments": ["--adapter", "warp"],
      "shareable": false
    },
    {
      // WT6: its own data folder, so the bundle holds this run's log and nothing of the desk's.
      "name": "a window with a data folder of its own, to save diagnostics",
      "variables": { "WINTIMELINE_DATA": "{files}" },
      "arguments": ["--adapter", "warp"],
      "shareable": false
    },
    {
      // WT7: the same data folder after a run that crashed in native code (0xC0000005).
      "name": "a window started after a native crash",
      "variables": { "WINTIMELINE_DATA": "{files}" },
      "before": [
        {
          "run": "src/WinTimeline.App/bin/{configuration}/net10.0-windows10.0.19041.0/win-x64/WinTimeline.exe",
          "arguments": ["--adapter", "warp", "--crash-test", "native"],
          "expectExit": -1073741819
        }
      ],
      "arguments": ["--adapter", "warp"],
      "shareable": false
    },
    {
      // WT13: --open on a corpus file.
      "name": "a window opened on the simple cut",
      "arguments": ["--open", "tests/fixtures/otio/corpus/simple_cut.otio", "--adapter", "warp"],
      "shareable": true
    },
    {
      // WT68: the surfaces show only once a document is open; an empty window shows the welcome page.
      "name": "a window opened on the simple cut on the default GPU",
      "arguments": ["--open", "tests/fixtures/otio/corpus/simple_cut.otio"],
      "shareable": true
    },
    {
      // WT152: the simple cut, with media beside it to drop on the viewer; not lent, since the drop replaces the document.
      "name": "a window on the simple cut, with media to drop on its viewer",
      "files": ["tests/fixtures/media/bars-3s-25p.mp4"],
      "variables": { "WINTIMELINE_DATA": "{files}" },
      "arguments": ["--open", "tests/fixtures/otio/corpus/simple_cut.otio", "--adapter", "warp"],
      "shareable": false
    },
    {
      // WT158: an empty window with the CMX samples' 25 fps EDL staged beside it, to open through File > Open.
      "name": "an empty window with a 25 fps EDL to open",
      "files": ["tests/fixtures/edl/samples/25fps.edl"],
      "variables": { "WINTIMELINE_DATA": "{files}" },
      "arguments": ["--adapter", "warp"],
      "shareable": false
    },
    {
      // WT68: an empty window with its own data folder, so its recent list starts empty.
      "name": "an empty window to drop media on",
      "files": ["tests/fixtures/media/bars-3s-25p.mp4"],
      "variables": { "WINTIMELINE_DATA": "{files}" },
      "arguments": ["--adapter", "warp"],
      "shareable": false
    },
    {
      "name": "a window asked to open a timeline that is not there",
      "arguments": ["--open", "tests/fixtures/otio/nowhere.otio", "--adapter", "warp"],
      "shareable": true
    },
    {
      // WT14: the bundle OpenTimelineIO itself wrote.
      "name": "a window opened on the reference's bundle",
      "files": ["tests/fixtures/otio/bundles/reference.otioz"],
      "variables": { "WINTIMELINE_DATA": "{files}" },
      "arguments": ["--open", "{files}/reference.otioz", "--adapter", "warp"],
      "shareable": false
    },
    {
      // WT17: a run that removed a clip and then crashed in native code, before any save.
      "name": "a window started after a crash with an unsaved edit",
      "files": ["tests/fixtures/otio/corpus/simple_cut.otio", "cases/fixtures/edits/remove-first.jsonl"],
      "variables": { "WINTIMELINE_DATA": "{files}" },
      "before": [
        {
          "run": "src/WinTimeline.App/bin/{configuration}/net10.0-windows10.0.19041.0/win-x64/WinTimeline.exe",
          "arguments": ["--open", "{files}/simple_cut.otio", "--run-commands", "{files}/remove-first.jsonl", "--adapter", "warp", "--crash-test", "native"],
          "expectExit": -1073741819
        }
      ],
      "arguments": ["--adapter", "warp"],
      "shareable": false
    },
    {
      // WT18: a timeline whose media was under C:\gone\media and now sits beside it.
      "name": "a window on a timeline whose media moved",
      "files": ["cases/fixtures/relink/moved.otio", "tests/fixtures/otio/bundles/media/shot-a.mov", "tests/fixtures/otio/bundles/media/shot-b.wav"],
      "arguments": ["--open", "{files}/moved.otio", "--adapter", "warp"],
      "shareable": false
    },
    {
      // WT19: a transition longer than the clips it overlaps; not lent, since its case fixes it.
      "name": "a window on a timeline with a transition too long",
      "arguments": ["--open", "tests/fixtures/broken/long-transition.otio", "--adapter", "warp"],
      "shareable": false
    },
    {
      // WT20: three reels in one SerializableCollection; staged, since its case saves a copy beside it.
      "name": "a window on a file of three reels",
      "files": ["tests/fixtures/collections/reels.otio"],
      "arguments": ["--open", "{files}/reels.otio", "--adapter", "warp"],
      "shareable": false
    },
    {
      // WT21: two versions of a cut with known edits between them, in one collection.
      "name": "a window on two versions of a cut",
      "arguments": ["--open", "tests/fixtures/diff/cuts.otio", "--adapter", "warp"],
      "shareable": true
    },
    {
      // WT47: a feature-length cut, 24 tracks and 3,000 clips (tests/fixtures/timeline/make_feature.py).
      "name": "a window on a feature-length cut",
      "arguments": ["--open", "tests/fixtures/timeline/feature.otio", "--adapter", "warp"],
      "shareable": true
    },
    {
      // WT156: Premiere's FCP 7 XML and Final Cut's FCPXML, from their adapters' own samples.
      "name": "a window opened on a Premiere FCP 7 XML",
      "arguments": ["--open", "tests/fixtures/fcp/samples/premiere_example.xml", "--adapter", "warp"],
      "shareable": true
    },
    {
      "name": "a window opened on an FCPXML project",
      "arguments": ["--open", "tests/fixtures/fcpx/samples/fcpx_project.fcpxml", "--adapter", "warp"],
      "shareable": true
    },
    {
      // WT50: a cut of one video and one audio track; not lent, since its case adds, locks and deletes tracks.
      "name": "a window on a cut whose tracks are managed",
      "arguments": ["--open", "tests/fixtures/diff/cut_v1.otio", "--adapter", "warp"],
      "shareable": false
    },
    {
      // WT48: the same cut, not lent, since its case zooms it.
      "name": "a feature-length cut to zoom",
      "arguments": ["--open", "tests/fixtures/timeline/feature.otio", "--adapter", "warp"],
      "shareable": false
    },
    {
      // WT15: an EDL from the CMX 3600 adapter's own samples.
      "name": "a window opened on an EDL",
      "arguments": ["--open", "tests/fixtures/edl/samples/dissolve_test.edl", "--edl-rate", "24", "--adapter", "warp"],
      "shareable": true
    },
    {
      // Not lent: its case saves a copy beside the staged file.
      "name": "a window on a staged timeline, to save as",
      "files": ["tests/fixtures/otio/corpus/simple_cut.otio"],
      "arguments": ["--open", "{files}/simple_cut.otio", "--adapter", "warp"],
      "shareable": false
    }
  ],

  "cases": [
    {
      "name": "a default start puts a window named WinTimeline on the desk",
      "catches": "an app that builds its window and then shows something else, or nothing at all, which every in-process test would pass",
      "filed": "WT1",
      "tags": ["smoke", "window"],
      "fixture": "the window a default start opens",
      "steps": [
        {
          "locator": "TitleBar",
          "act": "read",
          "reads": "name",
          "matches": "WinTimeline$",
          "named": "the title bar ends in the app's name"
        }
      ]
    },

    {
      "name": "the empty window has a menu bar, a dock area and a status bar",
      "catches": "a window that opens without the chrome every later panel docks into",
      "filed": "WT1",
      "tags": ["smoke", "window"],
      "fixture": "the window a default start opens",
      "steps": [
        {
          "locator": "MenuItem#FileMenu",
          "act": "read",
          "reads": "name",
          "expect": "File",
          "named": "the menu bar starts with File"
        },
        {
          "locator": "Text#StatusText",
          "act": "read",
          "reads": "name",
          "expect": "Ready",
          "named": "the status bar says Ready"
        }
      ]
    },

    {
      "name": "the status bar names the GPU the app runs on",
      "catches": "a device that fails to open, or opens on an adapter the status bar never names",
      "filed": "WT3",
      "tags": ["smoke", "gpu"],
      "fixture": "the window a default start opens",
      "steps": [
        {
          "locator": "Text#GpuStatus",
          "act": "read",
          "reads": "name",
          "matches": "^GPU: .+",
          "named": "the GPU chip names an adapter"
        }
      ]
    },

    {
      "name": "--adapter warp runs on the software rasteriser whatever GPU the desk has",
      "catches": "an --adapter flag that is parsed and then ignored, leaving the device on the hardware GPU",
      "filed": "WT3",
      "tags": ["gpu", "command-line"],
      "fixture": "a window forced onto WARP",
      "steps": [
        {
          "locator": "Text#GpuStatus",
          "act": "read",
          "reads": "name",
          "expect": "GPU: Microsoft Basic Render Driver (software)",
          "named": "the GPU chip names WARP"
        }
      ]
    },

    {
      // WT4: a swap chain publishes nothing, so each surface's peer reports its size and frames.
      "name": "the viewer and the timeline surfaces present frames on the GPU",
      "catches": "a surface whose swap chain never presents, is stuck at one pixel, or lands on another device than the status bar names",
      "filed": "WT4",
      "tags": ["smoke", "gpu", "surface"],
      "fixture": "a window opened on the simple cut on the default GPU",
      "steps": [
        {
          "locator": "Pane#ViewerSurface",
          "act": "read",
          "reads": "status",
          "matches": "^[1-9]\\d+ × [1-9]\\d+ px, [1-9]\\d* frames, hardware$",
          "named": "the viewer has a real size and has presented on the hardware GPU"
        },
        {
          "locator": "Pane#TimelineSurface",
          "act": "read",
          "reads": "status",
          "matches": "^[1-9]\\d+ × [1-9]\\d+ px, [1-9]\\d* frames, hardware, draw .+$",
          "named": "and so has the timeline, which says how long a frame took to draw"
        }
      ]
    },

    {
      "name": "on WARP the surfaces still present",
      "catches": "a surface that needs a hardware GPU, which would leave a VM with a black window",
      "filed": "WT4",
      "tags": ["gpu", "surface"],
      "fixture": "a window opened on the simple cut",
      "steps": [
        {
          "locator": "Pane#ViewerSurface",
          "act": "read",
          "reads": "status",
          "matches": "^[1-9]\\d+ × [1-9]\\d+ px, [1-9]\\d* frames, WARP$",
          "named": "the viewer presents on WARP"
        }
      ]
    },

    {
      "name": "a damaged settings file starts the app on the defaults and says so",
      "catches": "a settings file cut off by a crash that stops the app from starting, or that is silently replaced with the evidence lost",
      "filed": "WT5",
      "tags": ["settings"],
      "fixture": "a window started on a damaged settings file",
      "steps": [
        {
          "locator": "Text#StatusText",
          "act": "read",
          "reads": "name",
          "expect": "Settings could not be read; defaults are in use. The file was kept as settings.json.broken.",
          "named": "the status bar says the settings were damaged and where they went"
        },
        {
          "file": "{files}/settings.json.broken",
          "act": "read",
          "sameBytesAs": "cases/fixtures/settings/settings.json",
          "named": "and the damaged file is kept as it was"
        }
      ]
    },

    {
      "name": "Help saves a diagnostics bundle where the Save dialog is told",
      "catches": "a diagnostics command that opens a dialog and writes nothing, or writes somewhere else",
      "filed": "WT6",
      "tags": ["diagnostics", "dialog"],
      "fixture": "a window with a data folder of its own, to save diagnostics",
      "steps": [
        {
          "locator": "MenuItem#HelpMenu",
          "act": "expand",
          "named": "the Help menu is opened"
        },
        {
          "locator": "MenuItem#DiagnosticsMenuItem",
          "act": "invoke",
          "named": "Create diagnostics bundle is chosen"
        },
        {
          "locator": "Window[class=\"#32770\"]",
          "act": "choose file",
          "with": "{files}/diag.zip",
          "named": "the dialog is told to save diag.zip in the data folder"
        },
        {
          "locator": "Text#StatusText",
          "act": "read",
          "reads": "name",
          "expect": "Diagnostics saved to diag.zip.",
          "named": "the status bar says where it went"
        }
      ]
    },

    {
      "name": "the start after a native crash says so and offers the diagnostics bundle",
      "catches": "a crash that is forgotten by the next start, so nobody sends the log that would explain it",
      "filed": "WT7",
      "tags": ["crash", "recovery"],
      "fixture": "a window started after a native crash",
      "steps": [
        {
          "locator": "Text#RecoveryText",
          "act": "read",
          "reads": "name",
          "matches": "^WinTimeline closed unexpectedly last time \\(started .+\\)\\.",
          "named": "the recovery bar says the last run crashed"
        },
        {
          "locator": "Button#RecoveryDiagnostics",
          "act": "read",
          "reads": "enabled",
          "expect": "enabled",
          "named": "and offers the diagnostics bundle"
        },
        {
          "locator": "Button#RecoveryDismiss",
          "act": "invoke",
          "named": "it is dismissed"
        },
        {
          "locator": "Text#RecoveryText",
          "act": "read",
          "absent": true,
          "named": "and goes"
        }
      ]
    },

    {
      "name": "--open shows the timeline's name in the title and what it holds",
      "catches": "an --open that is parsed and ignored, or a file that opens without saying what it holds",
      "filed": "WT13",
      "tags": ["smoke", "open", "otio"],
      "fixture": "a window opened on the simple cut",
      "steps": [
        {
          "locator": "TitleBar",
          "act": "read",
          "reads": "name",
          "matches": "^simple_cut\\.otio — WinTimeline$",
          "named": "the title names the file"
        },
        {
          "locator": "Text#StatusText",
          "act": "read",
          "reads": "name",
          "matches": "^Opened simple_cut\\.otio: 4 clips on 1 track\\.",
          "named": "the status bar says what it holds"
        }
      ]
    },

    {
      "name": "--open on a missing timeline says so and keeps the empty window",
      "catches": "an open that fails silently or crashes the app on a bad path",
      "filed": "WT13",
      "tags": ["open", "otio"],
      "fixture": "a window asked to open a timeline that is not there",
      "steps": [
        {
          "locator": "Text#StatusText",
          "act": "read",
          "reads": "name",
          "expect": "nowhere.otio could not be opened: it was not found",
          "named": "the status bar names the missing file"
        },
        {
          "locator": "TitleBar",
          "act": "read",
          "reads": "name",
          "matches": "^WinTimeline$",
          "named": "and the title names no document"
        }
      ]
    },

    {
      "name": "Save As writes the timeline exactly as OpenTimelineIO itself writes it",
      "catches": "a save that drops a field, reorders keys or rewrites numbers, which another tool would read differently",
      "filed": "WT13",
      "tags": ["save", "otio", "dialog"],
      "fixture": "a window on a staged timeline, to save as",
      "steps": [
        {
          "locator": "MenuItem#FileMenu",
          "act": "expand",
          "named": "the File menu is opened"
        },
        {
          "locator": "MenuItem#SaveAsMenuItem",
          "act": "invoke",
          "named": "Save As is chosen"
        },
        {
          "locator": "Window[class=\"#32770\"]",
          "act": "choose file",
          "with": "{files}/copy.otio",
          "named": "the dialog is told to save copy.otio beside it"
        },
        {
          "locator": "Text#StatusText",
          "act": "read",
          "reads": "name",
          "expect": "Saved copy.otio.",
          "named": "the status bar says it saved"
        },
        {
          "file": "{files}/copy.otio",
          "act": "read",
          "sameBytesAs": "tests/fixtures/otio/written/simple_cut.otio",
          "named": "and the file holds the reference library's own bytes"
        }
      ]
    },

    {
      "name": "a bundle opens and saves again as a bundle with its media",
      "catches": "an .otioz the app cannot open, or a bundle saved without the media it carried",
      "filed": "WT14",
      "tags": ["open", "save", "otio", "bundle", "dialog"],
      "fixture": "a window opened on the reference's bundle",
      "steps": [
        {
          "locator": "Text#StatusText",
          "act": "read",
