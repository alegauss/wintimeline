<Project Sdk="Microsoft.NET.Sdk">

  <!-- WT3: the shared GPU device and the adapter choice. The device tests run on WARP, so they
       pass on a desk with no GPU, a VM or CI; the hardware test runs where DXGI lists one. -->
  <PropertyGroup>
    <RootNamespace>WinTimeline.Render.Tests</RootNamespace>
    <!-- The decode test writes its frames straight into Media Foundation's locked buffers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinTimeline.Render\WinTimeline.Render.csproj" />
  </ItemGroup>

</Project>
