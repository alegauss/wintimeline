<Project Sdk="Microsoft.NET.Sdk">

  <!-- WT150: compiles the render layer's HLSL at build time, so a shader that does not compile
       fails the build with the compiler's file, line and message instead of crashing a desk.
       Runs d3dcompiler_47 (FXC), which every Windows 10 ships: D3D11 takes DXBC (shader model 5)
       only, which DXC cannot emit. Never shipped; WinTimeline.Render's build runs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>WinTimeline.ShaderCompiler</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>

</Project>
