<Project Sdk="Microsoft.NET.Sdk">

  <!-- The headless tool: open, validate and render a project with no window, for scripts and for
       the cases. Started by WT1 with its usage alone; WT147 gives it its commands. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>WinTimeline.Cli</RootNamespace>
    <AssemblyName>wintimeline</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

</Project>
