# cmd.exe reads labels and blocks wrongly from LF-only batch files.
*.cmd text eol=crlf

# Every fixture is checked out with the bytes it was committed with: the reference's output is
# compared byte for byte (WT13, WT15), and a Windows runner's core.autocrlf would otherwise turn
# expected JSON into CRLF and fail every comparison, as CI run 41852163527 did on the EDL samples.
tests/fixtures/** -text
cases/fixtures/** -text

# The scripts that make the fixtures stay text.
tests/fixtures/**/*.py text eol=lf
tests/fixtures/**/*.cmd text eol=crlf
